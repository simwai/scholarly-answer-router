# Copy to .env. All values are optional; the router runs with no keys at all on
# the anonymous Kilo free tier.

ROUTER_PORT=8787
ROUTER_HOST=127.0.0.1

# Ordered tiers. The first is a FREE endpoint on NVIDIA NIM; without a NIM key
# the router skips it and uses Kilo's free tiers anonymously.
ROUTER_PIN=stepfun-ai/step-5-preview,nvidia/nemotron-3.5-super-vl:free,kilo-auto/free
ROUTER_LAST_RESORT=kilo-auto/free
ROUTER_ALLOW_FALLBACK=true

# Reasoning depth. Kilo needs this advertised per model (checked at runtime);
# NIM ignores "high" and uses NIM_REASONING_BUDGET instead.
ROUTER_REASONING=high
NIM_REASONING_BUDGET=16384

# Upstreams. Both defaults are the documented URLs; trailing slashes are stripped.
KILO_BASE_URL=https://ai-gateway.kilo.ai/api/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional. KILO_API_KEY raises Kilo's anonymous 200 req/hr limit.
# NVIDIA_API_KEY is REQUIRED only for the first (Step 5) tier; it is free from
# https://build.nvidia.com/settings and needs no credit card.
# KILO_API_KEY=
# NVIDIA_API_KEY=

# Cache: exact key + TTL. Not semantic - see README.
ROUTER_ENABLE_CACHE=true
ROUTER_CACHE_TTL_MS=900000

# Scan requests and responses for API keys, proxy credentials and PII.
ROUTER_EGRESS_ENABLED=true

# Per-upstream timeout, and the total deadline for a whole tier walk.
ROUTER_REQUEST_TIMEOUT_MS=120000
ROUTER_DEADLINE_MS=150000
