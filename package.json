{
  "name": "scholarly-answer-router",
  "version": "0.1.0",
  "private": true,
  "description": "Free-tier LLM router: ordered tier walking over Kilo and NVIDIA NIM, OpenAI-compatible, non-streaming.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check:catalog": "node dist/index.js --check-catalog",
    "smoke": "node dist/index.js --check-catalog"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
